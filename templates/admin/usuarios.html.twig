{% extends 'admin/_base.html.twig' %}

{% block title %}{{ 'admin.menu.usuarios'|trans }}{% endblock %}

{% block admin %}
    <h1 class="mb-8">{{ 'admin.menu.usuarios'|trans }}</h1>
    <div class="tabla-envoltura">
        <table class="tabla">
            <thead>
                <tr>
                    <th>{{ 'registro.nombre'|trans }}</th>
                    <th>{{ 'registro.email'|trans }}</th>
                    <th>{{ 'admin.usuario.rol'|trans }}</th>
                    <th>{{ 'admin.usuario.alta'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for usuario in usuarios %}
                    <tr>
                        <td>
                            <span class="flex items-center gap-3 font-semibold">
                                <span class="grid size-9 shrink-0 place-items-center rounded-full bg-superficie-2 text-sm font-bold text-suave uppercase" aria-hidden="true">{{ usuario.nombre|first }}</span>
                                {{ usuario.nombre }}
                            </span>
                        </td>
                        <td class="text-suave">{{ usuario.email }}</td>
                        <td>
                            {% if usuario.esAdmin %}
                                <span class="rounded-full bg-marca-500/10 px-2.5 py-1 text-xs font-bold text-acento">{{ 'admin.usuario.admin'|trans }}</span>
                            {% else %}
                                <span class="rounded-full bg-superficie-2 px-2.5 py-1 text-xs font-bold text-suave">{{ 'admin.usuario.cliente'|trans }}</span>
                            {% endif %}
                        </td>
                        <td class="whitespace-nowrap text-suave">{{ usuario.creadoEn|date('d/m/Y') }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
