{# Tarjeta de un auto en las grillas. Recibe "auto" y, opcional, "nivel" del título (2 por defecto). #}
{% set nivel = nivel ?? 2 %}
<li class="tarjeta">
    <a href="{{ path('auto_detalle', {slug: auto.slug}) }}">
        <div class="tarjeta__foto">
            {% if auto.portada %}
                <img src="{{ auto.portada.url }}" alt="{{ auto.portada.alt.en(app.locale) ?: auto.nombre }}" loading="lazy">
            {% else %}
                <span class="sin-foto">{{ 'auto.sin_foto'|trans }}</span>
            {% endif %}
            {% if auto.tieneVideo %}<span class="etiqueta">▶ {{ 'auto.video'|trans }}</span>{% endif %}
        </div>
        <div class="tarjeta__info">
            <h{{ nivel }} class="tarjeta__titulo">{{ auto.marca }} {{ auto.modelo }}</h{{ nivel }}>
            <p class="datos">{{ auto.anio }} · {{ auto.kilometraje|numero }} km · {{ auto.transmision|trans({}, 'valores') }}</p>
            {% if auto.motor or auto.potencia %}
                <p class="datos datos--motor">{{ auto.motor }}{% if auto.motor and auto.potencia %} · {% endif %}{% if auto.potencia %}{{ auto.potencia|numero }} hp{% endif %}</p>
            {% endif %}
            <p class="precio">{% include 'auto/_precio.html.twig' with {precio: auto.precio} only %}</p>
        </div>
    </a>
</li>
