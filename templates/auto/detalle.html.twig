{% extends 'base.html.twig' %}
{% import '_iconos.html.twig' as i %}

{% block title %}{{ auto.nombre }}{% endblock %}

{% block body %}
    <a class="enlace volver" href="{{ path('auto_listado') }}">{{ 'auto.volver'|trans }}</a>

    <article class="detalle grid animate-aparecer items-start gap-8 lg:grid-cols-[1.35fr_1fr] lg:gap-12">
        <div class="galeria lg:sticky lg:top-24" data-controller="galeria">
            {% if auto.medios is empty %}
                <div class="galeria__principal aspect-[16/10] overflow-hidden rounded-3xl border border-borde"><span class="sin-foto">{{ 'auto.sin_medios'|trans }}</span></div>
            {% else %}
                <div class="galeria__principal overflow-hidden rounded-3xl border border-borde bg-black shadow-elevada">
                    {% for medio in auto.medios %}
                        <div class="galeria__slide relative aspect-[16/10] [&_iframe]:size-full [&_img]:size-full [&_img]:object-cover [&_video]:size-full [&_video]:object-contain" data-galeria-target="slide" {{ not loop.first ? 'hidden' }}>
                            {% include 'auto/_medio.html.twig' %}
                            {% if medio.credito %}<p class="galeria__credito">{{ medio.credito }}</p>{% endif %}
                        </div>
                    {% endfor %}
                </div>

                {% if auto.medios|length > 1 %}
                    <div class="galeria__miniaturas scroll-sin-barra mt-4 flex gap-3 overflow-x-auto p-1">
                        {% for medio in auto.medios %}
                            <button type="button" class="miniatura {{ loop.first ? 'activa' }} relative grid aspect-[16/10] w-24 shrink-0 cursor-pointer place-items-center overflow-hidden rounded-xl border border-borde bg-superficie-2 text-suave opacity-60 transition hover:opacity-100 sm:w-28 [&.activa]:opacity-100 [&.activa]:ring-2 [&.activa]:ring-marca-500 [&.activa]:ring-offset-2 [&.activa]:ring-offset-fondo"
                                    data-galeria-target="miniatura"
                                    data-action="galeria#mostrar"
                                    data-galeria-indice-param="{{ loop.index0 }}"
                                    aria-label="{{ (medio.esImagen ? 'auto.ver_foto' : 'auto.ver_video')|trans({numero: loop.index}) }}">
                                {% if medio.esImagen %}
                                    <img class="size-full object-cover" src="{{ medio.url }}" alt="" loading="lazy">
                                {% else %}
                                    <span class="grid size-9 place-items-center rounded-full bg-marca-600 text-white">{{ i.icono('play', 'size-4') }}</span>
                                {% endif %}
                            </button>
                        {% endfor %}
                    </div>
                {% endif %}
            {% endif %}
        </div>

        <div class="ficha flex flex-col gap-6">
            <div>
                <p class="mb-2 text-xs font-bold tracking-[0.2em] text-acento uppercase">{{ auto.marca }} · {{ auto.anio }}</p>
                <h1 class="text-3xl leading-tight sm:text-4xl">{{ auto.marca }} {{ auto.modelo }}</h1>
                {% if auto.version %}<p class="ficha__version mt-2 text-suave">{{ auto.version }}</p>{% endif %}
            </div>

            <div class="cristal flex flex-wrap items-center justify-between gap-4 p-5">
                <p class="precio precio--grande font-display text-3xl text-texto sm:text-4xl">{% include 'auto/_precio.html.twig' with {precio: auto.precio} only %}</p>
                <a class="boton" href="#consulta">{{ i.icono('mensaje', 'size-4') }} {{ 'consulta.titulo'|trans }}</a>
            </div>

            <p class="text-pretty text-suave">{{ auto.descripcion.en(app.locale) }}</p>

            <dl class="especificaciones">
                <div><dt>{{ 'auto.anio'|trans }}</dt><dd>{{ auto.anio }}</dd></div>
                <div><dt>{{ 'auto.kilometraje'|trans }}</dt><dd>{{ auto.kilometraje|numero }} km</dd></div>
                <div><dt>{{ 'auto.combustible'|trans }}</dt><dd>{{ auto.combustible|trans({}, 'valores') }}</dd></div>
                <div><dt>{{ 'auto.transmision'|trans }}</dt><dd>{{ auto.transmision|trans({}, 'valores') }}</dd></div>
                <div><dt>{{ 'auto.carroceria'|trans }}</dt><dd>{{ auto.carroceria|trans({}, 'valores') }}</dd></div>
            </dl>

            {% if auto.tieneDatosMotor %}
                <div class="overflow-hidden rounded-3xl bg-gradient-to-br from-neutral-900 via-neutral-950 to-marca-950 p-6 text-white shadow-elevada ring-1 ring-white/10">
                    <h2 class="ficha__subtitulo mb-5 flex items-center gap-2 text-base">{{ i.icono('velocimetro', 'size-5 text-marca-400') }}{{ 'auto.motor_prestaciones'|trans }}</h2>
                    <dl class="especificaciones [&>div]:border-white/10 [&>div]:bg-white/5 [&>div:hover]:border-marca-400/50 [&_dd]:text-white [&_dt]:text-white/60">
                        {% if auto.motor %}<div><dt>{{ 'auto.motor'|trans }}</dt><dd>{{ auto.motor }}</dd></div>{% endif %}
                        {% if auto.potencia %}<div><dt>{{ 'auto.potencia'|trans }}</dt><dd>{{ auto.potencia|numero }} hp</dd></div>{% endif %}
                        {% if auto.torque %}<div><dt>{{ 'auto.torque'|trans }}</dt><dd>{{ auto.torque|numero }} Nm</dd></div>{% endif %}
                        {% if auto.traccion %}<div><dt>{{ 'auto.traccion'|trans }}</dt><dd>{{ auto.traccion|trans({}, 'valores') }}</dd></div>{% endif %}
                        {% if auto.aceleracion %}<div><dt>{{ 'auto.aceleracion'|trans }}</dt><dd>{{ auto.aceleracion|numero }} s</dd></div>{% endif %}
                        {% if auto.velocidadMaxima %}<div><dt>{{ 'auto.velocidad_maxima'|trans }}</dt><dd>{{ auto.velocidadMaxima|numero }} km/h</dd></div>{% endif %}
                    </dl>
                </div>
            {% endif %}
        </div>
    </article>

    <section class="consulta relative mt-16 grid scroll-mt-24 gap-8 overflow-hidden rounded-[2rem] border border-borde bg-superficie p-6 shadow-elevada sm:p-10 lg:grid-cols-[1fr_1.6fr]" id="consulta">
        <div class="pointer-events-none absolute -top-24 -left-24 size-72 rounded-full bg-marca-500/20 blur-3xl" aria-hidden="true"></div>
        <div class="consulta__texto relative">
            <span class="mb-5 grid size-12 place-items-center rounded-2xl bg-gradient-to-br from-marca-500 to-marca-700 text-white shadow-brillo">{{ i.icono('mensaje', 'size-6') }}</span>
            <h2 class="text-2xl sm:text-3xl">{{ 'consulta.titulo'|trans }}</h2>
            <p class="mt-3 text-suave">{{ 'consulta.intro'|trans({auto: auto.nombre}) }}</p>
        </div>
        {{ form_start(form, {attr: {class: 'formulario formulario--dos relative', novalidate: 'novalidate'}}) }}
            {{ form_errors(form) }}
            {{ form_row(form.nombre) }}
            {{ form_row(form.email) }}
            {# Teléfono: país (con su prefijo) + número; se guarda junto en formato +54... #}
            <fieldset class="formulario__ancho m-0 min-w-0 border-0 p-0"data-controller="telefono">
                <legend>{{ 'consulta.telefono'|trans }}</legend>
                {{ form_errors(form.telefono) }}
                {# El error es del teléfono entero: se marcan las dos partes. #}
                {% set telefono_mal = form.telefono.vars.valid ? {} : {'aria-invalid': 'true'} %}
                <div class="grid gap-2 sm:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
                    <div>
                        {{ form_label(form.telefono.pais, null, {label_attr: {class: 'sr-only'}}) }}
                        {{ form_widget(form.telefono.pais, {attr: telefono_mal}) }}
                    </div>
                    <div>
                        {{ form_label(form.telefono.numero, null, {label_attr: {class: 'sr-only'}}) }}
                        {{ form_widget(form.telefono.numero, {attr: {'aria-describedby': 'telefono-ayuda'}|merge(telefono_mal)}) }}
                    </div>
                </div>
                <p class="ayuda" id="telefono-ayuda">{{ 'consulta.telefono_ayuda'|trans }}</p>
            </fieldset>
            <div class="formulario__ancho">{{ form_row(form.mensaje) }}</div>
            <div class="formulario__ancho">
                <button type="submit" class="boton">{{ 'consulta.enviar'|trans }} {{ i.icono('enviar', 'size-4') }}</button>
            </div>
        {{ form_end(form) }}
    </section>
{% endblock %}
