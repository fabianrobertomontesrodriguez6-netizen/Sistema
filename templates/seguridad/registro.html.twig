{% extends 'base.html.twig' %}
{% import '_iconos.html.twig' as i %}

{% block title %}{{ 'registro.titulo'|trans }}{% endblock %}

{% block body %}
    <div class="relative mx-auto max-w-lg animate-aparecer py-4">
        <div class="absolute -inset-4 -z-10 rounded-[2.5rem] bg-gradient-to-tr from-marca-600/25 via-orange-400/10 to-transparent blur-2xl" aria-hidden="true"></div>
        <section class="panel-entrada panel-entrada--centrado cristal p-7 sm:p-10">
            <span class="mb-6 grid size-12 place-items-center rounded-2xl bg-gradient-to-br from-marca-500 to-marca-700 text-white shadow-brillo">{{ i.icono('usuario', 'size-6') }}</span>
            <h1 class="text-2xl sm:text-3xl">{{ 'registro.titulo'|trans }}</h1>
            <p class="panel-entrada__intro mt-3 mb-8 text-suave">{{ 'registro.intro'|trans }}</p>

            {{ form_start(form, {attr: {class: 'formulario', novalidate: 'novalidate'}}) }}
                {{ form_errors(form) }}
                {{ form_row(form.nombre) }}
                {{ form_row(form.email) }}
                <div class="grid gap-5 sm:grid-cols-2">
                    {{ form_row(form.plainPassword.first) }}
                    {{ form_row(form.plainPassword.second) }}
                </div>
                <button type="submit" class="boton boton--ancho">{{ 'registro.crear'|trans }} {{ i.icono('flecha', 'size-4') }}</button>
            {{ form_end(form) }}

            <p class="panel-entrada__pie mt-7 border-t border-borde pt-6 text-center text-sm text-suave">
                {{ 'registro.ya_tengo'|trans }}
                <a class="enlace" href="{{ path('landing') }}">{{ 'landing.entrar'|trans }}</a>
            </p>
        </section>
    </div>
{% endblock %}
